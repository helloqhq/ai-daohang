{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI information event",
  "type": "object",
  "required": [
    "id",
    "entity_ids",
    "kind",
    "topics",
    "title_zh",
    "summary_zh",
    "key_points_zh",
    "importance_reason_zh",
    "published_at",
    "date_precision",
    "first_collected_at",
    "updated_at",
    "sources",
    "title_en",
    "summary_en",
    "key_points_en",
    "importance_reason_en"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
    },
    "entity_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "kind": {
      "type": "string",
      "enum": [
        "update",
        "preview",
        "opinion"
      ]
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "enum": [
          "model_release",
          "capability",
          "api",
          "pricing",
          "availability",
          "feature",
          "compatibility",
          "critical_fix"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "title_zh": {
      "type": "string",
      "minLength": 1
    },
    "summary_zh": {
      "type": "string",
      "minLength": 1
    },
    "key_points_zh": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "importance_reason_zh": {
      "type": "string",
      "minLength": 1
    },
    "translation_zh": {
      "type": "string",
      "minLength": 1
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "date_precision": {
      "type": "string",
      "enum": [
        "datetime",
        "date",
        "unknown"
      ]
    },
    "first_collected_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "url",
          "material_scope",
          "collected_at"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "format": "uri"
          },
          "material_scope": {
            "type": "string",
            "enum": [
              "metadata_only",
              "partial_text",
              "full_text"
            ]
          },
          "collected_at": {
            "type": "string",
            "minLength": 1
          },
          "content_id": {
            "type": "string",
            "minLength": 1
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_locator": {
            "type": "object"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "related_event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "at",
          "reason_zh",
          "url",
          "reason_en"
        ],
        "properties": {
          "at": {
            "type": "string",
            "minLength": 1
          },
          "reason_zh": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "format": "uri"
          },
          "reason_en": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "title_en": {
      "type": "string",
      "minLength": 1
    },
    "summary_en": {
      "type": "string",
      "minLength": 1
    },
    "key_points_en": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "importance_reason_en": {
      "type": "string",
      "minLength": 1
    },
    "translation_en": {
      "type": "string",
      "minLength": 1
    }
  }
}
